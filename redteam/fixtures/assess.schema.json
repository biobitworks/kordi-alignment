{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/biobitworks/kordi-alignment/tree/main/redteam/fixtures/assess.schema.json",
  "title": "Alignment Compass core JSON input",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "items"],
  "properties": {
    "scope": {
      "type": "string",
      "enum": ["fictional", "agent_decision"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,64}(?![\\s\\S])"
          },
          "lawChaos": {
            "type": "number",
            "minimum": -2,
            "maximum": 2
          },
          "goodEvil": {
            "type": "number",
            "minimum": -2,
            "maximum": 2
          },
          "evidence": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            }
          }
        }
      }
    }
  }
}
